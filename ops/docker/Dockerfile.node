# syntax=docker/dockerfile:1
#
# ArkConstellation Node — Validator or Sentry
#
# This single Dockerfile builds both validator and sentry nodes. The role
# (validator vs. sentry) and topology are configured at runtime via
# environment variables, not baked into the image. This follows the
# industry-standard pattern: one image, configurable at deploy time.

ARG GO_VERSION="1.25"
ARG IMG_TAG="3.19"

# --------------------------------------------------------
# Builder
# --------------------------------------------------------
FROM golang:${GO_VERSION}-alpine AS builder
WORKDIR /src/app/
RUN apk add --no-cache \
    ca-certificates \
    build-base \
    linux-headers \
    binutils-gold \
    git \
    wget

# Copy go modules
COPY go.mod go.sum ./

# Download go dependencies with cache mount
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Cosmwasm - Download correct libwasmvm version
RUN --mount=type=cache,target=/go/pkg/mod \
    ARCH=$(uname -m) && WASMVM_VERSION=$(go list -m github.com/CosmWasm/wasmvm/v3 | sed 's/.* //') && \
    wget https://github.com/CosmWasm/wasmvm/releases/download/${WASMVM_VERSION}/libwasmvm_muslc.${ARCH}.a \
    -O /lib/libwasmvm_muslc.${ARCH}.a

# Copy remaining source code
COPY . .

RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    LEDGER_ENABLED=false BUILD_TAGS='muslc osusergo pebbledb' LINK_STATICALLY=true make build

# --------------------------------------------------------
# Runtime
# --------------------------------------------------------
FROM alpine:3.19

RUN apk add --no-cache \
    ca-certificates \
    jq \
    curl \
    tini \
    && addgroup -g 1025 nonroot \
    && adduser -D nonroot -u 1025 -G nonroot

COPY --from=builder /src/app/build/arkd /usr/local/bin/arkd
RUN chmod +x /usr/local/bin/arkd \
    && ln -sf /usr/local/bin/arkd /usr/local/bin/mantrachaind

# Node data and config
RUN mkdir -p /home/nonroot/.ark && chown -R nonroot:nonroot /home/nonroot

# Copy entrypoint
COPY ops/docker/entrypoint.sh /entrypoint.sh
COPY ops/docker/setup-devnet.sh /setup-devnet.sh
COPY networks/devnet/genesis-template.json /genesis-template.json
RUN chmod +x /entrypoint.sh

# P2P, RPC, Prometheus metrics, JSON-RPC, WebSocket, LCD
EXPOSE 26656 26657 9090 8545 8546 1317

USER nonroot
WORKDIR /home/nonroot

# Health check: CometBFT RPC /status endpoint
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -sf http://127.0.0.1:26657/status > /dev/null 2>&1 || exit 1

ENTRYPOINT ["tini", "--", "/entrypoint.sh"]
CMD ["start"]
