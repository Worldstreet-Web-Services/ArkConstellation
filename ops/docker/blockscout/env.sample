# ==========================================
# Blockscout Local Environment Configuration
# ==========================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=blockscout
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Network / Chain Settings
ETHEREUM_JSONRPC_VARIANT=geth
ETHEREUM_JSONRPC_HTTP_URL=http://host.docker.internal:8545
NEXT_PUBLIC_NETWORK_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=9000
COIN=KASH
COIN_NAME=KASH
DISPLAY_DECIMALS=18
DECIMALS=18
NETWORK="ArkConstellation Devnet"
SUBNETWORK="arkdevnet_9000-1"

# Cosmos-EVM Specific Settings
INDEXER_DISABLE_BLOCK_REWARD_FETCHER=true
INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=true
INDEXER_DISABLE_PENDING_TRANSACTIONS_FETCHER=true

# Ports
BACKEND_PORT=4000
FRONTEND_PORT=3000
