# --- ADDED: Cosmos gRPC ------------------------------------------------------
# Required by IBC relayers (Hermes, the Go relayer) for account queries and
# transaction simulation. RPC and LCD are not sufficient.
#
# The node already serves gRPC: entrypoint.sh moves it to 0.0.0.0:9095 to leave
# 9090 to CometBFT's Prometheus endpoint, and `netstat` inside ark-sentry-0
# confirms :::9095 LISTEN. What is missing is that 9095 is not published to the
# host — see the port addition in ops/docker/docker-compose.devnet.yml. Until
# sentry-0 is recreated with that mapping, this route has nothing to reach.
#
# h2c is required. gRPC is HTTP/2; without this Caddy speaks HTTP/1.1 to the
# upstream and every call fails with a protocol error that reads like a network
# fault rather than a configuration mistake.
grpc.34.60.137.196.sslip.io {
    reverse_proxy localhost:9095 {
        transport http {
            versions h2c 2
        }
    }
}
