# ArkConstellation devnet — public endpoints.
#
# Fixes rpc./lcd. (currently returning nothing), adds grpc. (never configured,
# and the blocker for the Hermes IBC relayer), and pins timeouts on explorer.
# so a slow Blockscout render fails fast instead of hanging the handshake.
#
# Upstreams are 127.0.0.1:<published port> because Caddy runs on the host and is
# not a member of the `arkdevnet` compose network, so Docker service DNS is not
# available to it. Ports below match what docker-compose.devnet.yml publishes.
{
	# Uncomment while debugging; Caddy logs TLS issuance failures here and those
	# are the usual cause of a hostname that works intermittently.
	# debug
}

(cors) {
	@options method OPTIONS
	respond @options 204
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization"
	}
}

# --- CometBFT RPC ------------------------------------------------------------
# Needs websocket passthrough: Hermes subscribes to /websocket for events, and
# a plain reverse_proxy without the Connection/Upgrade headers preserved will
# 400 on the handshake.
rpc.34.60.137.196.sslip.io {
	import cors
	reverse_proxy 127.0.0.1:26657 {
		header_up Host {upstream_hostport}
		header_up X-Forwarded-For {remote_host}
	}
}

# --- Cosmos REST / LCD -------------------------------------------------------
lcd.34.60.137.196.sslip.io {
	import cors
	reverse_proxy 127.0.0.1:1317
}

# --- Cosmos gRPC -------------------------------------------------------------
# THE HERMES BLOCKER.
#
# There is no port conflict to resolve: entrypoint.sh already relocates the node's
# gRPC server to 0.0.0.0:9095 specifically to leave 9090 to CometBFT's Prometheus
# endpoint, which ops/monitoring/prometheus.yml scrapes as sentry-0:9090. The
# only thing missing was that 9095 was never published to the host — fixed in
# docker-compose.devnet.yml alongside this file.
#
# The upstream must be reached over h2c. gRPC is HTTP/2, and Caddy otherwise
# downgrades to HTTP/1.1, at which point every call fails with a protocol error
# that reads like a network fault rather than a config mistake.
grpc.34.60.137.196.sslip.io {
	reverse_proxy 127.0.0.1:9095 {
		transport http {
			versions h2c 2
		}
	}
}

# --- EVM JSON-RPC ------------------------------------------------------------
evm.34.60.137.196.sslip.io {
	import cors
	reverse_proxy 127.0.0.1:8545
}

evm-ws.34.60.137.196.sslip.io {
	reverse_proxy 127.0.0.1:8546
}

# --- Blockscout --------------------------------------------------------------
# Intermittent failures here are usually the frontend being slow rather than
# down — it was observed at ~56% CPU. Without explicit timeouts Caddy holds the
# connection until the client gives up, which looks like a dead host. These make
# it fail fast and visibly instead.
explorer.34.60.137.196.sslip.io {
	reverse_proxy 127.0.0.1:3000 {
		transport http {
			dial_timeout 10s
			response_header_timeout 30s
		}
	}
}

explorer-api.34.60.137.196.sslip.io {
	import cors
	reverse_proxy 127.0.0.1:4000 {
		transport http {
			dial_timeout 10s
			response_header_timeout 30s
		}
	}
}

# --- Faucet ------------------------------------------------------------------
faucet.34.60.137.196.sslip.io {
	import cors
	reverse_proxy 127.0.0.1:8088
}
